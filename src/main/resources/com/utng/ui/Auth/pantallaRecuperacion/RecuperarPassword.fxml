<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.utng.AuthModule.controller.RecuperarPasswordController"      
      alignment="CENTER"
      spacing="15"
      prefWidth="400"
      prefHeight="250">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>


    <Label text="Recuperar contraseña"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>


    <TextField fx:id="txtCorreo"
               promptText="Correo electrónico"
               prefWidth="250"/>


    <Label fx:id="lblMensaje"
           text=""
           wrapText="true"/>


    <Button text="Enviar solicitud"
            prefWidth="250"
            onAction="#recuperarPassword"/>


</VBox>