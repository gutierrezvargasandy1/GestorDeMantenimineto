<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.utng.AuthModule.controller.RecuperarPasswordController"      
      alignment="CENTER"
      spacing="15">

    <padding>
        <Insets top="20" right="40" bottom="30" left="40"/>
    </padding>

    <!-- HBox con maxWidth para que la flecha quede alineada con los inputs -->
    <HBox alignment="CENTER_LEFT" maxWidth="300">
        <Button text="← Regresar" 
                onAction="#regresar" 
                style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-cursor: hand; -fx-text-fill: #333;"/>
    </HBox>

    <Label text="Recuperar contraseña"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <TextField fx:id="txtCorreo"
               promptText="Correo electrónico"
               maxWidth="300"
               prefHeight="35"/>

    <Label fx:id="lblMensaje"
           text=""
           wrapText="true"/>

    <Button text="Enviar solicitud"
            maxWidth="300"
            prefHeight="35"
            onAction="#recuperarPassword"/>

</VBox>