<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.utng.AuthModule.controller.NuevaPasswordController"      
      alignment="CENTER"
      spacing="15"
      prefWidth="400"
      prefHeight="350">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="Nueva Contraseña"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label text="Crea una nueva contraseña para tu cuenta"
           wrapText="true"
           alignment="CENTER"/>

    <PasswordField fx:id="txtNuevaPassword"
                   promptText="Nueva contraseña"
                   prefWidth="250"/>

    <PasswordField fx:id="txtConfirmarPassword"
                   promptText="Confirmar contraseña"
                   prefWidth="250"/>

    <Label fx:id="lblMensaje"
           text=""
           wrapText="true"/>

    <Button text="Cambiar contraseña"
            prefWidth="250"
            onAction="#cambiarPassword"/>

</VBox>