                                    style="-fx-background-color: #f4f6fa; -fx-text-fill: #475569; -fx-font-size: 10.5px;
                                           -fx-background-radius: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 16;
                                           -fx-padding: 6 12 6 12; -fx-cursor: hand;"/>
                            <Button text="Necesito el numero de equipo" onAction="#usarSugerencia"
                                    style="-fx-background-color: #f4f6fa; -fx-text-fill: #475569; -fx-font-size: 10.5px;
                                           -fx-background-radius: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 16;
                                           -fx-padding: 6 12 6 12; -fx-cursor: hand;"/>
                            <Button text="Se programo para manana" onAction="#usarSugerencia"
                                    style="-fx-background-color: #f4f6fa; -fx-text-fill: #475569; -fx-font-size: 10.5px;
                                           -fx-background-radius: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 16;
                                           -fx-padding: 6 12 6 12; -fx-cursor: hand;"/>
                        </HBox>

                        <HBox spacing="8" alignment="CENTER_LEFT">
