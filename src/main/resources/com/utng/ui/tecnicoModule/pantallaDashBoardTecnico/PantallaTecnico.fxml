                                               -fx-background-radius: 7; -fx-padding: 7 14 7 14; -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    

                    <!-- ─────────── TAB: HISTORIAL ─────────── -->
                    <Tab text="  Historial  ">
                        <VBox spacing="12">
