                                    <TableColumn fx:id="hsId"       text="id"                          prefWidth="60"/>
                                    <TableColumn fx:id="hsFecha"    text="fecha"                       prefWidth="110"/>
                                    <TableColumn fx:id="hsTipo"     text="tipo"                        prefWidth="130"/>
                                    <TableColumn fx:id="hsIdEquipo" text="id_equipo"                   prefWidth="90"/>
                                    <TableColumn fx:id="hsEquipo"   text="equipo"                      prefWidth="160"/>
                                    <TableColumn fx:id="hsIdMant"   text="id_registro_mantenimiento"   prefWidth="190"/>
                                    <TableColumn fx:id="hsIdAct"    text="id_registro_actualizacion"   prefWidth="190"/>
                                    <TableColumn fx:id="hsDesc"     text="descripcion"                 prefWidth="280"/>
                                </columns>
                            </TableView>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label fx:id="lblConteoHist" text="0 movimientos"
                                       style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Exportar CSV" onAction="#exportarHistorial"
