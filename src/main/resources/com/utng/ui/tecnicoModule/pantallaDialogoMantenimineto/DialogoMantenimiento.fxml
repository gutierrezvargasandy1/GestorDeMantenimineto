<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.utng.TecnicoModule.controller.DialogoMantenimientoController"
      spacing="14" prefWidth="620"
      style="-fx-background-color: white;">
    <padding><Insets top="20" right="24" bottom="6" left="24"/></padding>

    <!-- CABECERA -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="🔧"
               style="-fx-font-size: 15px;
                      -fx-background-color: linear-gradient(to bottom right, #3b82f6, #1d4ed8);
                      -fx-background-radius: 10; -fx-min-width: 36; -fx-min-height: 36;
                      -fx-alignment: center;"/>
        <VBox spacing="1">
            <Label fx:id="lblTitulo" text="Registrar mantenimiento"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Label text="Tabla registros_mantenimiento"
                   style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblIdRegistro" text="nuevo"
               style="-fx-font-size: 10.5px; -fx-font-weight: bold; -fx-text-fill: #1d4ed8;
                      -fx-background-color: #eef2ff; -fx-background-radius: 16;
                      -fx-padding: 5 11 5 11;"/>
    </HBox>

    <Region prefHeight="1" style="-fx-background-color: #eef1f5;"/>

    <!-- FORMULARIO -->
    <GridPane hgap="12" vgap="11">
        <columnConstraints>
            <ColumnConstraints minWidth="185" prefWidth="185"/>
            <ColumnConstraints minWidth="355" prefWidth="355" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="id_equipo *" GridPane.rowIndex="0" GridPane.columnIndex="0"
               style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
        <ComboBox fx:id="cmbEquipo" GridPane.rowIndex="0" GridPane.columnIndex="1"
                  prefHeight="32" maxWidth="Infinity" promptText="Selecciona el equipo"
                  style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                         -fx-border-color: #e2e8f0; -fx-border-radius: 7; -fx-font-size: 11.5px;"/>

        <Label text="tipo *" GridPane.rowIndex="1" GridPane.columnIndex="0"
               style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
        <ComboBox fx:id="cmbTipo" GridPane.rowIndex="1" GridPane.columnIndex="1"
                  prefHeight="32" maxWidth="Infinity" promptText="Preventivo / Correctivo / ..."
                  style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                         -fx-border-color: #e2e8f0; -fx-border-radius: 7; -fx-font-size: 11.5px;"/>

        <Label text="motivo *" GridPane.rowIndex="2" GridPane.columnIndex="0"
               style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
        <TextArea fx:id="txtMotivo" GridPane.rowIndex="2" GridPane.columnIndex="1"
                  prefRowCount="2" wrapText="true"
                  promptText="Que reporto el usuario / por que se atiende"
                  style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                         -fx-border-color: #e2e8f0; -fx-border-radius: 7; -fx-font-size: 11.5px;"/>

        <Label text="mantenimiento_realizado" GridPane.rowIndex="3" GridPane.columnIndex="0"
               style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
        <TextArea fx:id="txtRealizado" GridPane.rowIndex="3" GridPane.columnIndex="1"
                  prefRowCount="3" wrapText="true"
                  promptText="Que se hizo (se puede llenar despues, al completar)"
                  style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                         -fx-border-color: #e2e8f0; -fx-border-radius: 7; -fx-font-size: 11.5px;"/>

        <Label text="fecha *" GridPane.rowIndex="4" GridPane.columnIndex="0"
               style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
        <DatePicker fx:id="dpFecha" GridPane.rowIndex="4" GridPane.columnIndex="1"
                    prefHeight="32" maxWidth="Infinity"
                    style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                           -fx-border-color: #e2e8f0; -fx-border-radius: 7; -fx-font-size: 11.5px;"/>

        <Label text="fecha_proxima" GridPane.rowIndex="5" GridPane.columnIndex="0"
               style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
        <DatePicker fx:id="dpFechaProxima" GridPane.rowIndex="5" GridPane.columnIndex="1"
                    prefHeight="32" maxWidth="Infinity"
                    style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                           -fx-border-color: #e2e8f0; -fx-border-radius: 7; -fx-font-size: 11.5px;"/>

        <Label text="estado *" GridPane.rowIndex="6" GridPane.columnIndex="0"
               style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
        <ComboBox fx:id="cmbEstado" GridPane.rowIndex="6" GridPane.columnIndex="1"
                  prefHeight="32" maxWidth="Infinity" promptText="Pendiente"
                  style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                         -fx-border-color: #e2e8f0; -fx-border-radius: 7; -fx-font-size: 11.5px;"/>

        <Label text="id_usuario_responsable" GridPane.rowIndex="7" GridPane.columnIndex="0"
               style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
        <Label fx:id="lblResponsable" text="-" GridPane.rowIndex="7" GridPane.columnIndex="1"
               maxWidth="Infinity"
               style="-fx-font-size: 11.5px; -fx-text-fill: #0f172a;
                      -fx-background-color: #f1f5f9; -fx-background-radius: 7;
                      -fx-padding: 8 11 8 11;"/>
    </GridPane>

    <Label fx:id="lblError" text="" wrapText="true" managed="false" visible="false"
           style="-fx-font-size: 11px; -fx-text-fill: #b91c1c;
                  -fx-background-color: #fef2f2; -fx-background-radius: 8;
                  -fx-border-color: #fecaca; -fx-border-radius: 8;
                  -fx-padding: 9 12 9 12;"/>

    <Label text="Al guardar se agrega tambien un movimiento en historial_registros."
           style="-fx-font-size: 10.5px; -fx-text-fill: #64748b;"/>
</VBox>