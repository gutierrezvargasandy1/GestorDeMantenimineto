<file path="src/main/resources/com/utng/ui/mantenimientoModules/pantallaMantenimientos/PantallaMantenimientos.fxml">
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.utng.MantenimientoModule.controller.PantallaMantenimientosController">

    <!-- ══════════ CONTENIDO PRINCIPAL ══════════ -->
    <VBox spacing="16"
          style="-fx-background-color: linear-gradient(to bottom, #eef2f7 0%, #f7f8fa 320px);">
        <padding>
            <Insets top="20" right="30" bottom="20" left="30"/>
        </padding>

        <!-- ══════════ ENCABEZADO ══════════ -->
        <HBox alignment="CENTER_LEFT" spacing="14">
            <Button fx:id="btnMenu" text="☰" onAction="#toggleMenu"
                    prefWidth="42" prefHeight="42"
                    style="-fx-font-size: 17px; -fx-text-fill: #0f172a;
                           -fx-background-color: white; -fx-background-radius: 10;
                           -fx-border-color: #e2e8f0; -fx-border-radius: 10;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 8, 0, 0, 2);"/>

            <VBox spacing="1">
                <Label text="Mantenimientos"
                       style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Label text="CGTI · Registros de mantenimiento preventivo y correctivo de los equipos"
                       style="-fx-font-size: 11.5px; -fx-text-fill: #64748b;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="←  Regresar" onAction="#volver"
                    prefHeight="34"
                    style="-fx-background-color: white; -fx-text-fill: #475569; -fx-font-size: 11.5px;
                           -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;
                           -fx-padding: 0 14 0 14; -fx-cursor: hand;"/>

            <Button text="＋  Nuevo mantenimiento"
                    onAction="#nuevoMantenimiento"
                    prefHeight="34"
                    style="-fx-background-color: linear-gradient(to bottom right, #3b82f6, #1d4ed8);
                           -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;
                           -fx-background-radius: 8; -fx-padding: 0 16 0 16; -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(29,78,216,0.35), 10, 0, 0, 3);"/>
        </HBox>

        <!-- ══════════ TARJETAS KPI ══════════ -->
        <HBox spacing="12">
            <!-- TOTAL -->
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 16 12 16;
                         -fx-border-color: #e8ecf2; -fx-border-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 8, 0, 0, 2);">
                <Label text="🔧" style="-fx-font-size: 12px; -fx-background-color: #eef2ff;
                                       -fx-background-radius: 8; -fx-min-width: 30; -fx-min-height: 30;
                                       -fx-alignment: center;"/>
                <VBox spacing="1">
                    <Label fx:id="lblTotalMantenimientos" text="0"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Label text="Registros de mantenimiento"
                           style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>

            <!-- REALIZADOS -->
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 16 12 16;
                         -fx-border-color: #e8ecf2; -fx-border-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 8, 0, 0, 2);">
                <Label text="✔" style="-fx-font-size: 12px; -fx-text-fill: #15803d;
                                      -fx-background-color: #dcfce7; -fx-background-radius: 8;
                                      -fx-min-width: 30; -fx-min-height: 30; -fx-alignment: center;"/>
                <VBox spacing="1">
                    <Label fx:id="lblRealizados" text="0"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #15803d;"/>
                    <Label text="Realizados"
                           style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>

            <!-- PENDIENTES -->
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 16 12 16;
                         -fx-border-color: #e8ecf2; -fx-border-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 8, 0, 0, 2);">
                <Label text="⏳" style="-fx-font-size: 12px; -fx-text-fill: #b45309;
                                      -fx-background-color: #fef3c7; -fx-background-radius: 8;
                                      -fx-min-width: 30; -fx-min-height: 30; -fx-alignment: center;"/>
                <VBox spacing="1">
                    <Label fx:id="lblPendientes" text="0"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #b45309;"/>
                    <Label text="Pendientes"
                           style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>

            <!-- VENCIDOS -->
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 16 12 16;
                         -fx-border-color: #e8ecf2; -fx-border-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 8, 0, 0, 2);">
                <Label text="⚠" style="-fx-font-size: 12px; -fx-text-fill: #b91c1c;
                                      -fx-background-color: #fee2e2; -fx-background-radius: 8;
                                      -fx-min-width: 30; -fx-min-height: 30; -fx-alignment: center;"/>
                <VBox spacing="1">
                    <Label fx:id="lblVencidos" text="0"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #b91c1c;"/>
                    <Label text="Vencidos (fecha próxima pasada)"
                           style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>
        </HBox>

        <!-- ══════════ PANEL DE MANTENIMIENTOS ══════════ -->
        <VBox spacing="12" VBox.vgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16;
                     -fx-border-color: #e8ecf2; -fx-border-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 10, 0, 0, 3);">

            <!-- BARRA BUSCADORA + FILTROS -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Mantenimientos registrados"
                       style="-fx-font-size: 14.5px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Region HBox.hgrow="ALWAYS"/>

                <TextField fx:id="txtBuscar" promptText="🔍  Buscar mantenimiento…"
                           prefWidth="230" prefHeight="30"
                           onKeyReleased="#filtrarMantenimientos"
                           style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                                  -fx-border-color: #e2e8f0; -fx-border-radius: 7;
                                  -fx-font-size: 11.5px; -fx-padding: 0 10 0 10;"/>

                <ComboBox fx:id="cmbCampo" prefHeight="30" prefWidth="150"
                          promptText="Buscar en…" onAction="#filtrarMantenimientos"
                          style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                                 -fx-border-color: #e2e8f0; -fx-border-radius: 7; -fx-font-size: 11.5px;"/>

                <ComboBox fx:id="cmbTipo" prefHeight="30" prefWidth="140"
                          promptText="Todos los tipos" onAction="#filtrarMantenimientos"
                          style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                                 -fx-border-color: #e2e8f0; -fx-border-radius: 7; -fx-font-size: 11.5px;"/>

                <ComboBox fx:id="cmbSituacion" prefHeight="30" prefWidth="160"
                          promptText="Todas las situaciones" onAction="#filtrarMantenimientos"
                          style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                                 -fx-border-color: #e2e8f0; -fx-border-radius: 7; -fx-font-size: 11.5px;"/>

                <ComboBox fx:id="cmbEquipo" prefHeight="30" prefWidth="190"
                          promptText="Todos los equipos" onAction="#filtrarMantenimientos"
                          style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                                 -fx-border-color: #e2e8f0; -fx-border-radius: 7; -fx-font-size: 11.5px;"/>

                <Button text="Limpiar" onAction="#limpiarFiltros"
                        style="-fx-background-color: #eef2ff; -fx-text-fill: #1d4ed8;
                               -fx-font-weight: bold; -fx-font-size: 11.5px;
                               -fx-background-radius: 7; -fx-padding: 7 12 7 12; -fx-cursor: hand;"/>
            </HBox>

            <!-- CHIPS DE SITUACIÓN -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <HBox fx:id="contenedorChips" spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="chipTodos" text="Todos" onAction="#filtrarPorSituacion"
                            style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-font-size: 11px;
                                   -fx-font-weight: bold; -fx-background-radius: 16;
                                   -fx-padding: 5 13 5 13; -fx-cursor: hand;"/>

                    <Button fx:id="chipRealizados" text="Realizados" onAction="#filtrarPorSituacion"
                            style="-fx-background-color: #f0fdf4; -fx-text-fill: #15803d; -fx-font-size: 11px;
                                   -fx-font-weight: bold; -fx-background-radius: 16;
                                   -fx-border-color: #bbf7d0; -fx-border-radius: 16;
                                   -fx-padding: 5 13 5 13; -fx-cursor: hand;"/>

                    <Button fx:id="chipPendientes" text="Pendientes" onAction="#filtrarPorSituacion"
                            style="-fx-background-color: #fffbeb; -fx-text-fill: #b45309; -fx-font-size: 11px;
                                   -fx-font-weight: bold; -fx-background-radius: 16;
                                   -fx-border-color: #fde68a; -fx-border-radius: 16;
                                   -fx-padding: 5 13 5 13; -fx-cursor: hand;"/>

                    <Button fx:id="chipVencidos" text="Vencidos" onAction="#filtrarPorSituacion"
                            style="-fx-background-color: #fef2f2; -fx-text-fill: #b91c1c; -fx-font-size: 11px;
                                   -fx-font-weight: bold; -fx-background-radius: 16;
                                   -fx-border-color: #fecaca; -fx-border-radius: 16;
                                   -fx-padding: 5 13 5 13; -fx-cursor: hand;"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblResultados" text="0 mantenimientos"
                       style="-fx-font-size: 11px; -fx-text-fill: #64748b;
                              -fx-background-color: #f4f6fa; -fx-background-radius: 16;
                              -fx-padding: 5 12 5 12;"/>
            </HBox>

            <!-- TABLA -->
            <TableView fx:id="tablaMantenimientos" VBox.vgrow="ALWAYS" prefHeight="360"
                       style="-fx-background-color: transparent; -fx-border-color: #eef1f5;
                              -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 11.5px;">
                <placeholder>
                    <VBox alignment="CENTER" spacing="5">
                        <Label text="🔧" style="-fx-font-size: 22px; -fx-opacity: 0.35;"/>
                        <Label text="No se encontraron mantenimientos con los filtros aplicados"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                    </VBox>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colId"          text="ID"             prefWidth="55"/>
                    <TableColumn fx:id="colEquipo"      text="Equipo"         prefWidth="180"/>
                    <TableColumn fx:id="colLugar"       text="Lugar"          prefWidth="150"/>
                    <TableColumn fx:id="colResponsable" text="Responsable"    prefWidth="160"/>
                    <TableColumn fx:id="colTipo"        text="Tipo"           prefWidth="110"/>
                    <TableColumn fx:id="colMotivo"      text="Motivo"         prefWidth="250"/>
                    <TableColumn fx:id="colFecha"       text="Fecha"          prefWidth="100"/>
                    <TableColumn fx:id="colProxima"     text="Próxima fecha"  prefWidth="110"/>
                    <TableColumn fx:id="colSituacion"   text="Situación"      prefWidth="115"/>
                    <TableColumn fx:id="colAcciones"    text="Acciones"       prefWidth="120"
                                 sortable="false"/>
                </columns>
            </TableView>

            <!-- BOTONERA INFERIOR -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Doble clic sobre una fila para editar"
                       style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnVer" text="👁  Ver detalle" onAction="#verMantenimiento"
                        style="-fx-background-color: #f4f6fa; -fx-text-fill: #475569; -fx-font-size: 11.5px;
                               -fx-background-radius: 7; -fx-border-color: #e2e8f0; -fx-border-radius: 7;
                               -fx-padding: 7 12 7 12; -fx-cursor: hand;"/>

                <Button fx:id="btnEditar" text="✏  Editar" onAction="#editarMantenimiento"
                        style="-fx-background-color: #eef2ff; -fx-text-fill: #1d4ed8; -fx-font-weight: bold;
                               -fx-font-size: 11.5px; -fx-background-radius: 7;
                               -fx-padding: 7 12 7 12; -fx-cursor: hand;"/>

                <Button fx:id="btnEliminar" text="🗑  Eliminar" onAction="#eliminarMantenimiento"
                        style="-fx-background-color: #fee2e2; -fx-text-fill: #b91c1c; -fx-font-weight: bold;
                               -fx-font-size: 11.5px; -fx-background-radius: 7;
                               -fx-padding: 7 12 7 12; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- ══════════ OVERLAY OSCURO ══════════ -->
    <Region fx:id="overlayMenu" visible="false" managed="false"
            onMouseClicked="#toggleMenu"
            style="-fx-background-color: rgba(15,23,42,0.45);"/>

    <!-- ══════════ MENÚ LATERAL (HAMBURGUESA) ══════════ -->
    <VBox fx:id="panelMenu" visible="false" managed="false"
          prefWidth="260" maxWidth="260"
          StackPane.alignment="CENTER_LEFT"
          spacing="6"
          style="-fx-background-color: #0f172a; -fx-padding: 24 16 24 16;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 20, 0, 4, 0);">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="🖥"
                   style="-fx-font-size: 16px;
                          -fx-background-color: linear-gradient(to bottom right, #3b82f6, #1d4ed8);
                          -fx-background-radius: 10; -fx-min-width: 38; -fx-min-height: 38;
                          -fx-alignment: center;"/>
            <VBox spacing="1">
                <Label text="CGTI" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Panel de navegación" style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✕" onAction="#toggleMenu"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8;
                           -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 4 8 4 8;"/>
        </HBox>

        <Region prefHeight="14"/>

        <Button text="🏠  Dashboard" onAction="#irADashboard"
                maxWidth="Infinity" alignment="CENTER_LEFT"
                style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 13px;
                       -fx-background-radius: 9;
                       -fx-padding: 12 14 12 14; -fx-cursor: hand;"/>

        <Button text="👥  Usuarios" onAction="#irAUsuarios"
                maxWidth="Infinity" alignment="CENTER_LEFT"
                style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 13px;
                       -fx-background-radius: 9;
                       -fx-padding: 12 14 12 14; -fx-cursor: hand;"/>

        <Button text="🖥  Equipos" onAction="#irAEquipos"
                maxWidth="Infinity" alignment="CENTER_LEFT"
                style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 13px;
                       -fx-background-radius: 9;
                       -fx-padding: 12 14 12 14; -fx-cursor: hand;"/>

        <Button text="💿  Sistemas operativos" onAction="#irASistemasOperativos"
                maxWidth="Infinity" alignment="CENTER_LEFT"
                style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 13px;
                       -fx-background-radius: 9;
                       -fx-padding: 12 14 12 14; -fx-cursor: hand;"/>

        <Button fx:id="btnMantenimientos" text="🔧  Mantenimientos" onAction="#irAMantenimientos"
                maxWidth="Infinity" alignment="CENTER_LEFT"
                style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-font-size: 13px;
                       -fx-font-weight: bold; -fx-background-radius: 9;
                       -fx-padding: 12 14 12 14; -fx-cursor: hand;"/>

        <Button text="🔄  Actualizaciones" onAction="#irAActualizaciones"
                maxWidth="Infinity" alignment="CENTER_LEFT"
                style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 13px;
                       -fx-background-radius: 9;
                       -fx-padding: 12 14 12 14; -fx-cursor: hand;"/>

        <Region VBox.vgrow="ALWAYS"/>

        <Button text="⏻  Cerrar sesión" onAction="#cerrarSesion"
                maxWidth="Infinity" alignment="CENTER_LEFT"
                style="-fx-background-color: transparent; -fx-text-fill: #f87171; -fx-font-size: 12.5px;
                       -fx-background-radius: 9; -fx-padding: 10 14 10 14; -fx-cursor: hand;"/>

       <HBox alignment="CENTER_LEFT" spacing="10"
      style="-fx-border-color: #1e293b; -fx-border-width: 1 0 0 0; -fx-padding: 14 0 0 0;">
    <Label fx:id="lblAvatarUsuario" text="GE"
           style="-fx-font-size: 10.5px; -fx-font-weight: bold; -fx-text-fill: white;
                  -fx-background-color: #334155; -fx-background-radius: 14;
                  -fx-min-width: 30; -fx-min-height: 30; -fx-alignment: center;"/>
    <VBox spacing="1">
        <Label fx:id="lblNombreUsuario" text="Gerardo" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label fx:id="lblRolUsuario" text="Técnico CGTI" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;"/>
    </VBox>
</HBox>
    </VBox>

</StackPane>
</file>

<file path="src/main/resources/com/utng/ui/tecnicoModule/pantallaDashBoardTecnico/PantallaTecnico.fxml">
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.utng.TecnicoModule.controller.PantallaTecnicoController">

    <stylesheets>
        <URL value="@../../estilos-cgti.css"/>
    </stylesheets>

    <!-- ══════════ CONTENIDO PRINCIPAL ══════════ -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                style="-fx-background-color: transparent; -fx-background: transparent;
                       -fx-border-color: transparent;">

        <VBox spacing="16"
              style="-fx-background-color: linear-gradient(to bottom, #eef2f7 0%, #f7f8fa 320px);">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>

            <!-- ENCABEZADO -->
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Button fx:id="btnMenu" text="☰" onAction="#toggleMenu"
                        prefWidth="42" prefHeight="42"
                        style="-fx-font-size: 17px; -fx-text-fill: #0f172a;
                               -fx-background-color: white; -fx-background-radius: 10;
                               -fx-border-color: #e2e8f0; -fx-border-radius: 10;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 8, 0, 0, 2);"/>

                <VBox spacing="1">
                    <Label text="Panel del Tecnico CGTI"
                           style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Label text="CGTI - Equipos, mantenimientos, actualizaciones y soporte"
                           style="-fx-font-size: 11.5px; -fx-text-fill: #64748b;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Tecnico"
                       style="-fx-font-size: 10.5px; -fx-font-weight: bold; -fx-text-fill: #16a34a;
                              -fx-background-color: #f0fdf4; -fx-background-radius: 16;
                              -fx-padding: 7 12 7 12;"/>

                <Label fx:id="lblFechaHoy" text="Domingo, 16 de agosto"
                       style="-fx-font-size: 11.5px; -fx-text-fill: #64748b;
                              -fx-background-color: white; -fx-background-radius: 8;
                              -fx-padding: 7 12 7 12;
                              -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>

                <Button text="Nueva actualizacion" onAction="#nuevaActualizacion" prefHeight="34"
                        style="-fx-background-color: #eef2ff; -fx-text-fill: #1d4ed8;
                               -fx-font-weight: bold; -fx-font-size: 12px;
                               -fx-background-radius: 8; -fx-padding: 0 14 0 14; -fx-cursor: hand;"/>

                <Button text="Registrar mantenimiento" onAction="#nuevoMantenimiento" prefHeight="34"
                        style="-fx-background-color: linear-gradient(to bottom right, #3b82f6, #1d4ed8);
                               -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;
                               -fx-background-radius: 8; -fx-padding: 0 16 0 16; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(29,78,216,0.35), 10, 0, 0, 3);"/>
            </HBox>

            <!-- TARJETAS KPI -->
            <HBox spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 16 12 16;
                             -fx-border-color: #e8ecf2; -fx-border-radius: 10;
                             -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 8, 0, 0, 2);">
                    <Label text="E" style="-fx-font-size: 12px; -fx-background-color: #eef2ff;
                                           -fx-background-radius: 8; -fx-min-width: 30; -fx-min-height: 30;
                                           -fx-alignment: center;"/>
                    <VBox spacing="1">
                        <Label fx:id="lblTotalEquipos" text="0"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                        <Label text="Equipos registrados"
                               style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 16 12 16;
                             -fx-border-color: #e8ecf2; -fx-border-radius: 10;
                             -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 8, 0, 0, 2);">
                    <Label text="P" style="-fx-font-size: 12px; -fx-background-color: #fef3c7;
                                           -fx-background-radius: 8; -fx-min-width: 30; -fx-min-height: 30;
                                           -fx-alignment: center;"/>
                    <VBox spacing="1">
                        <Label fx:id="lblPendientes" text="0"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                        <Label text="Mantenimientos pendientes"
                               style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 16 12 16;
                             -fx-border-color: #e8ecf2; -fx-border-radius: 10;
                             -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 8, 0, 0, 2);">
                    <Label text="V" style="-fx-font-size: 12px; -fx-background-color: #fee2e2;
                                           -fx-background-radius: 8; -fx-min-width: 30; -fx-min-height: 30;
                                           -fx-alignment: center;"/>
                    <VBox spacing="1">
                        <Label fx:id="lblVencidos" text="0"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                        <Label text="Vencidos (fecha_proxima)"
                               style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 16 12 16;
                             -fx-border-color: #e8ecf2; -fx-border-radius: 10;
                             -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 8, 0, 0, 2);">
                    <Label text="A" style="-fx-font-size: 12px; -fx-background-color: #dcfce7;
                                           -fx-background-radius: 8; -fx-min-width: 30; -fx-min-height: 30;
                                           -fx-alignment: center;"/>
                    <VBox spacing="1">
                        <Label fx:id="lblActualizacionesMes" text="0"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                        <Label text="Actualizaciones del mes"
                               style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- ══════════ PESTAÑAS DE TRABAJO ══════════ -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 8 8 12 8;
                         -fx-border-color: #e8ecf2; -fx-border-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 10, 0, 0, 3);">

                <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" tabMinHeight="30"
                         style="-fx-background-color: transparent; -fx-font-size: 12px;">

                    <!-- ─────────── TAB: EQUIPOS ─────────── -->
                    <Tab text="  Equipos  ">
                        <VBox spacing="12">
                            <padding><Insets top="14" right="8" bottom="4" left="8"/></padding>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Inventario de equipos"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="txtBuscarEquipo" promptText="Buscar equipo, modelo, procesador..."
                                           prefWidth="240" prefHeight="30" onKeyReleased="#filtrarEquipos"
                                           style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                                                  -fx-border-color: #e2e8f0; -fx-border-radius: 7;
                                                  -fx-font-size: 11.5px; -fx-padding: 0 10 0 10;"/>
                                <ComboBox fx:id="cmbLugar" prefHeight="30" prefWidth="130"
                                          promptText="Todos los lugares" onAction="#filtrarEquipos"
                                          style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                                                 -fx-border-color: #e2e8f0; -fx-border-radius: 7; -fx-font-size: 11.5px;"/>
                                <ComboBox fx:id="cmbEstadoEquipo" prefHeight="30" prefWidth="140"
                                          promptText="Todos los estados" onAction="#filtrarEquipos"
                                          style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                                                 -fx-border-color: #e2e8f0; -fx-border-radius: 7; -fx-font-size: 11.5px;"/>
                            </HBox>

                            <TableView fx:id="tablaEquipos" prefHeight="250"
                                       style="-fx-background-color: transparent; -fx-border-color: #eef1f5;
                                              -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 11.5px;">
                                <placeholder>
                                    <Label text="Sin equipos" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                                </placeholder>
                                <columns>
                                    <TableColumn fx:id="eqId"           text="id"                     prefWidth="55"/>
                                    <TableColumn fx:id="eqNombre"       text="equipos"                prefWidth="140"/>
                                    <TableColumn fx:id="eqModelo"       text="modelo"                 prefWidth="140"/>
                                    <TableColumn fx:id="eqProcesador"   text="procesador"             prefWidth="150"/>
                                    <TableColumn fx:id="eqRam"          text="memoria_ram"            prefWidth="100"/>
                                    <TableColumn fx:id="eqAlmacen"      text="almacenamiento"         prefWidth="115"/>
                                    <TableColumn fx:id="eqSO"           text="id_sistema_operativo"   prefWidth="150"/>
                                    <TableColumn fx:id="eqLugar"        text="lugar"                  prefWidth="130"/>
                                    <TableColumn fx:id="eqEstado"       text="estado"                 prefWidth="125"/>
                                    <TableColumn fx:id="eqAnio"         text="anio_creacion"          prefWidth="95"/>
                                    <TableColumn fx:id="eqResponsable"  text="id_usuario_responsable" prefWidth="150"/>
                                    <TableColumn fx:id="eqFechaCre"     text="fecha_creacion"         prefWidth="110"/>
                                    <TableColumn fx:id="eqFechaAct"     text="fecha_actualizacion"    prefWidth="130"/>
                                </columns>
                            </TableView>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label fx:id="lblConteoEquipos" text="0 equipos"
                                       style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Ficha tecnica" onAction="#verFichaEquipo"
                                        style="-fx-background-color: #f4f6fa; -fx-text-fill: #475569;
                                               -fx-font-weight: bold; -fx-font-size: 11.5px;
                                               -fx-background-radius: 7; -fx-border-color: #e2e8f0;
                                               -fx-border-radius: 7; -fx-padding: 7 12 7 12; -fx-cursor: hand;"/>
                                <Button text="Cambiar estado" onAction="#cambiarEstadoEquipo"
                                        style="-fx-background-color: #f4f6fa; -fx-text-fill: #475569;
                                               -fx-font-weight: bold; -fx-font-size: 11.5px;
                                               -fx-background-radius: 7; -fx-border-color: #e2e8f0;
                                               -fx-border-radius: 7; -fx-padding: 7 12 7 12; -fx-cursor: hand;"/>
                                <Button text="Registrar mantenimiento" onAction="#nuevoMantenimiento"
                                        style="-fx-background-color: linear-gradient(to bottom right, #3b82f6, #1d4ed8);
                                               -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11.5px;
                                               -fx-background-radius: 7; -fx-padding: 7 14 7 14; -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <!-- ─────────── TAB: MANTENIMIENTOS ─────────── -->
                    <Tab text="  Mantenimientos  ">
                        <VBox spacing="12">
                            <padding><Insets top="14" right="8" bottom="4" left="8"/></padding>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="registros_mantenimiento"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="txtBuscarMant" promptText="Buscar por equipo, motivo, tipo..."
                                           prefWidth="240" prefHeight="30" onKeyReleased="#filtrarMantenimientos"
                                           style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                                                  -fx-border-color: #e2e8f0; -fx-border-radius: 7;
                                                  -fx-font-size: 11.5px; -fx-padding: 0 10 0 10;"/>
                                <ComboBox fx:id="cmbTipoMant" prefHeight="30" prefWidth="140"
                                          promptText="Todos los tipos" onAction="#filtrarMantenimientos"
                                          style="-fx-background-color: #f4f6fa; -fx-background-radius: 7;
                                                 -fx-border-color: #e2e8f0; -fx-border-radius: 7; -fx-font-size: 11.5px;"/>
                            </HBox>

                            <!-- CHIPS DE ESTADO -->
                            <HBox spacing="8">
                                <Button fx:id="chipMantTodos" text="Todos" onAction="#filtrarPorEstadoMant"
                                        style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-font-size: 11px;
                                               -fx-font-weight: bold; -fx-background-radius: 16;
                                               -fx-padding: 5 13 5 13; -fx-cursor: hand;"/>

                                <HBox fx:id="chipPendiente" alignment="CENTER_LEFT" spacing="6"
                                      onMouseClicked="#filtrarPorEstadoMant"
                                      style="-fx-background-color: #fffbeb; -fx-background-radius: 16;
                                             -fx-border-color: #fde68a; -fx-border-radius: 16;
                                             -fx-padding: 5 12 5 12; -fx-cursor: hand;">
                                    <Label text="P" style="-fx-text-fill: #f59e0b; -fx-font-size: 10px;"/>
                                    <Label text="Pendiente" style="-fx-text-fill: #b45309; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                    <Label fx:id="lblMantPendiente" text="0"
                                           style="-fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold;
                                                  -fx-background-color: #f59e0b; -fx-background-radius: 9;
                                                  -fx-min-width: 18; -fx-alignment: center; -fx-padding: 1 5 1 5;"/>
                                </HBox>

                                <HBox fx:id="chipEnProceso" alignment="CENTER_LEFT" spacing="6"
                                      onMouseClicked="#filtrarPorEstadoMant"
                                      style="-fx-background-color: #eff6ff; -fx-background-radius: 16;
                                             -fx-border-color: #bfdbfe; -fx-border-radius: 16;
                                             -fx-padding: 5 12 5 12; -fx-cursor: hand;">
                                    <Label text="E" style="-fx-text-fill: #3b82f6; -fx-font-size: 10px;"/>
                                    <Label text="En proceso" style="-fx-text-fill: #1d4ed8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                    <Label fx:id="lblMantProceso" text="0"
                                           style="-fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold;
                                                  -fx-background-color: #3b82f6; -fx-background-radius: 9;
                                                  -fx-min-width: 18; -fx-alignment: center; -fx-padding: 1 5 1 5;"/>
                                </HBox>

                                <HBox fx:id="chipCompletado" alignment="CENTER_LEFT" spacing="6"
                                      onMouseClicked="#filtrarPorEstadoMant"
                                      style="-fx-background-color: #f0fdf4; -fx-background-radius: 16;
                                             -fx-border-color: #bbf7d0; -fx-border-radius: 16;
                                             -fx-padding: 5 12 5 12; -fx-cursor: hand;">
                                    <Label text="C" style="-fx-text-fill: #16a34a; -fx-font-size: 10px;"/>
                                    <Label text="Completado" style="-fx-text-fill: #15803d; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                    <Label fx:id="lblMantCompletado" text="0"
                                           style="-fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold;
                                                  -fx-background-color: #16a34a; -fx-background-radius: 9;
                                                  -fx-min-width: 18; -fx-alignment: center; -fx-padding: 1 5 1 5;"/>
                                </HBox>

                                <HBox fx:id="chipVencidos" alignment="CENTER_LEFT" spacing="6"
                                      onMouseClicked="#filtrarPorEstadoMant"
                                      style="-fx-background-color: #fef2f2; -fx-background-radius: 16;
                                             -fx-border-color: #fecaca; -fx-border-radius: 16;
                                             -fx-padding: 5 12 5 12; -fx-cursor: hand;">
                                    <Label text="V" style="-fx-text-fill: #dc2626; -fx-font-size: 10px;"/>
                                    <Label text="Vencidos" style="-fx-text-fill: #b91c1c; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                    <Label fx:id="lblMantVencidos" text="0"
                                           style="-fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold;
                                                  -fx-background-color: #dc2626; -fx-background-radius: 9;
                                                  -fx-min-width: 18; -fx-alignment: center; -fx-padding: 1 5 1 5;"/>
                                </HBox>
                            </HBox>

                            <TableView fx:id="tablaMantenimientos" prefHeight="250"
                                       style="-fx-background-color: transparent; -fx-border-color: #eef1f5;
                                              -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 11.5px;">
                                <placeholder>
                                    <Label text="Aun no registras mantenimientos"
                                           style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                                </placeholder>
                                <columns>
                                    <TableColumn fx:id="mtId"          text="id"                     prefWidth="55"/>
                                    <TableColumn fx:id="mtIdEquipo"    text="id_equipo"              prefWidth="85"/>
                                    <TableColumn fx:id="mtEquipo"      text="equipo"                 prefWidth="140"/>
                                    <TableColumn fx:id="mtTipo"        text="tipo"                   prefWidth="110"/>
                                    <TableColumn fx:id="mtMotivo"      text="motivo"                 prefWidth="220"/>
                                    <TableColumn fx:id="mtRealizado"   text="mantenimiento_realizado" prefWidth="230"/>
                                    <TableColumn fx:id="mtFecha"       text="fecha"                  prefWidth="100"/>
                                    <TableColumn fx:id="mtFechaProx"   text="fecha_proxima"          prefWidth="110"/>
                                    <TableColumn fx:id="mtEstado"      text="estado"                 prefWidth="120"/>
                                    <TableColumn fx:id="mtResponsable" text="id_usuario_responsable" prefWidth="150"/>
                                    <TableColumn fx:id="mtFechaReg"    text="fecha_registro"         prefWidth="115"/>
                                </columns>
                            </TableView>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label fx:id="lblConteoMant" text="0 registros"
                                       style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Editar" onAction="#editarMantenimiento"
                                        style="-fx-background-color: #f4f6fa; -fx-text-fill: #475569;
                                               -fx-font-weight: bold; -fx-font-size: 11.5px;
                                               -fx-background-radius: 7; -fx-border-color: #e2e8f0;
                                               -fx-border-radius: 7; -fx-padding: 7 12 7 12; -fx-cursor: hand;"/>
                                <Button text="Marcar completado" onAction="#completarMantenimiento"
                                        style="-fx-background-color: #f0fdf4; -fx-text-fill: #15803d;
                                               -fx-font-weight: bold; -fx-font-size: 11.5px;
