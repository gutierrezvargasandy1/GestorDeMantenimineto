package com.utng;

import com.mongodb.client.MongoDatabase;
import com.utng.config.ConectionDB;
import com.utng.config.MongoDBConnection;
import com.utng.util.Navigator;

import javafx.application.Application;
import javafx.stage.Stage;

public class App extends Application {

    @Override
    public void start(Stage stage) {
        Navigator.setStage(stage);
        Navigator.navigate(
                "/com/utng/ui/Auth/pantallaLogin/PantallaLogin.fxml");
        ConectionDB.conectar();
        MongoDatabase database = MongoDBConnection.getDatabase();
        System.out.println(
                "Base de datos: " + database.getName());

    }

    public static void main(String[] args) {

        launch(args);

    }

}
</file>

<file path="src/main/resources/com/utng/ui/usuarioModules/pantallaUsuarios/PantallaUsuarios.fxml">
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.utng.UserModule.controller.PantallaUsuariosController">

    <!-- ══════════ CONTENIDO PRINCIPAL ══════════ -->
    <VBox spacing="16"
          style="-fx-background-color: linear-gradient(to bottom, #eef2f7 0%, #f7f8fa 320px);">
        <padding>
            <Insets top="20" right="30" bottom="20" left="30"/>
        </padding>

        <!-- ══════════ ENCABEZADO ══════════ -->
        <HBox alignment="CENTER_LEFT" spacing="14">
            <Button fx:id="btnMenu" text="☰" onAction="#toggleMenu"
                    prefWidth="42" prefHeight="42"
                    style="-fx-font-size: 17px; -fx-text-fill: #0f172a;
                           -fx-background-color: white; -fx-background-radius: 10;
                           -fx-border-color: #e2e8f0; -fx-border-radius: 10;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 8, 0, 0, 2);"/>

            <VBox spacing="1">
                <Label text="Gestión de Usuarios"
                       style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Label text="CGTI · Altas, bajas, cambios y consulta de cuentas del sistema"
                       style="-fx-font-size: 11.5px; -fx-text-fill: #64748b;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="←  Regresar" onAction="#volver"
                    prefHeight="34"
                    style="-fx-background-color: white; -fx-text-fill: #475569; -fx-font-size: 11.5px;
                           -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;
                           -fx-padding: 0 14 0 14; -fx-cursor: hand;"/>

            <Button text="＋  Nuevo usuario"
                    onAction="#nuevoUsuario"
                    prefHeight="34"
                    style="-fx-background-color: linear-gradient(to bottom right, #3b82f6, #1d4ed8);
                           -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;
                           -fx-background-radius: 8; -fx-padding: 0 16 0 16; -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(29,78,216,0.35), 10, 0, 0, 3);"/>
        </HBox>

        <!-- ══════════ TARJETAS KPI ══════════ -->
        <HBox spacing="12">
            <!-- TOTAL -->
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 16 12 16;
                         -fx-border-color: #e8ecf2; -fx-border-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 8, 0, 0, 2);">
                <Label text="👥" style="-fx-font-size: 12px; -fx-background-color: #eef2ff;
                                       -fx-background-radius: 8; -fx-min-width: 30; -fx-min-height: 30;
                                       -fx-alignment: center;"/>
                <VBox spacing="1">
                    <Label fx:id="lblTotalUsuarios" text="0"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Label text="Total de usuarios"
                           style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>

            <!-- ADMINISTRADORES -->
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 16 12 16;
                         -fx-border-color: #e8ecf2; -fx-border-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 8, 0, 0, 2);">
                <Label text="🛡" style="-fx-font-size: 12px; -fx-text-fill: #7c3aed;
                                      -fx-background-color: #ede9fe; -fx-background-radius: 8;
                                      -fx-min-width: 30; -fx-min-height: 30; -fx-alignment: center;"/>
                <VBox spacing="1">
                    <Label fx:id="lblAdministradores" text="0"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
                    <Label text="Administradores"
                           style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>

            <!-- TÉCNICOS -->
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 16 12 16;
                         -fx-border-color: #e8ecf2; -fx-border-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 8, 0, 0, 2);">
                <Label text="🛠" style="-fx-font-size: 12px; -fx-text-fill: #2563eb;
                                      -fx-background-color: #dbeafe; -fx-background-radius: 8;
                                      -fx-min-width: 30; -fx-min-height: 30; -fx-alignment: center;"/>
                <VBox spacing="1">
                    <Label fx:id="lblTecnicos" text="0"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                    <Label text="Técnicos"
                           style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>

            <!-- CONSULTA -->
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 16 12 16;
                         -fx-border-color: #e8ecf2; -fx-border-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 8, 0, 0, 2);">
                <Label text="👁" style="-fx-font-size: 12px; -fx-text-fill: #0f766e;
                                      -fx-background-color: #ccfbf1; -fx-background-radius: 8;
                                      -fx-min-width: 30; -fx-min-height: 30; -fx-alignment: center;"/>
                <VBox spacing="1">
                    <Label fx:id="lblConsulta" text="0"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f766e;"/>
                    <Label text="Solo consulta"
                           style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>

            <!-- INACTIVOS -->
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 16 12 16;
                         -fx-border-color: #e8ecf2; -fx-border-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 8, 0, 0, 2);">
                <Label text="⛔" style="-fx-font-size: 12px; -fx-background-color: #fee2e2;
                                       -fx-background-radius: 8; -fx-min-width: 30; -fx-min-height: 30;
                                       -fx-alignment: center;"/>
                <VBox spacing="1">
                    <Label fx:id="lblInactivos" text="0"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                    <Label text="Inactivos"
                           style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>
        </HBox>

        <!-- ══════════ PANEL DE USUARIOS ══════════ -->
        <VBox spacing="12" VBox.vgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16;
                     -fx-border-color: #e8ecf2; -fx-border-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 10, 0, 0, 3);">

            <!-- BARRA BUSCADORA + FILTROS -->
