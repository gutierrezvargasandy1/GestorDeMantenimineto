                    <Label text="CGTI - Soporte tecnico y mantenimiento de equipos de computo"
                           style="-fx-font-size: 11.5px; -fx-text-fill: #64748b;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblFechaHoy" text="Sabado, 8 de agosto"
                       style="-fx-font-size: 11.5px; -fx-text-fill: #64748b;
