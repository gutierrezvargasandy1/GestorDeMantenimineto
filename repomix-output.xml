                </placeholder>
                <columns>
                    <TableColumn fx:id="colId"             text="ID"                 prefWidth="55"/>
                    <TableColumn fx:id="colModelo"         text="Modelo"             prefWidth="150"/>
                    <TableColumn fx:id="colLugar"          text="Lugar"              prefWidth="145"/>
                    <TableColumn fx:id="colProcesador"     text="Procesador"         prefWidth="150"/>
                    <TableColumn fx:id="colRam"            text="RAM"                prefWidth="75"/>
                    <TableColumn fx:id="colAlmacenamiento" text="Almacenamiento"     prefWidth="115"/>
                    <TableColumn fx:id="colAnio"           text="Año"                prefWidth="60"/>
                    <TableColumn fx:id="colSistemaOp"      text="Sistema operativo"  prefWidth="150"/>
                    <TableColumn fx:id="colResponsable"    text="Responsable"        prefWidth="150"/>
                    <TableColumn fx:id="colEstado"         text="Estado"             prefWidth="140"/>
                    <TableColumn fx:id="colAcciones"       text="Acciones"           prefWidth="120"
                                 sortable="false"/>
                </columns>
